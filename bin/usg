#!/usr/bin/env bash
# usg — show how much of the Claude and Codex subscription limits is used.
#
# Reads the OAuth access tokens the two CLIs already store (Claude: the macOS
# keychain or ~/.claude/.credentials.json; Codex: $CODEX_HOME/auth.json) and
# asks each vendor's usage endpoint, the same one its CLI uses. Neither
# endpoint is a documented API, so an unrecognised response is reported rather
# than guessed at.
#
# It never refreshes a token: a refresh can rotate the stored refresh token,
# which would sign the CLI out. When a token has expired, run the CLI once.
set -euo pipefail

CLAUDE_USAGE_URL="https://api.anthropic.com/api/oauth/usage"
CODEX_USAGE_URL="https://chatgpt.com/backend-api/wham/usage"
BAR_WIDTH=50

usage() {
    cat <<'EOF'
Usage: usg

Show used percentage and reset time for each Claude and Codex usage window.
Requires curl and jq, and a signed-in claude and/or codex CLI.
EOF
}

# GET a JSON endpoint. Headers arrive on stdin as curl config lines, so bearer
# tokens never appear in the process list. Prints the body; returns non-zero
# with a reason on stdout when the request did not produce a 200.
get_json() {
    local url="$1" body status
    body="$(mktemp)"
    status="$(curl -sS -m 20 -o "$body" -w '%{http_code}' -K - "$url" 2>/dev/null)" || status=000
    if [[ "$status" == 200 ]]; then
        cat "$body"
        rm -f "$body"
        return 0
    fi
    rm -f "$body"
    case "$status" in
        401 | 403) echo "token rejected (HTTP $status)" ;;
        000) echo "request failed" ;;
        *) echo "HTTP $status" ;;
    esac
    return 1
}

# Each provider prints one window per line as: label<TAB>percent<TAB>reset,
# where reset is epoch seconds or an ISO 8601 time. On failure it prints the
# reason instead and returns non-zero.

claude_windows() {
    local creds="" token expires_ms data
    if [[ "$(uname -s)" == Darwin ]]; then
        creds="$(/usr/bin/security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null || true)"
    fi
    if [[ -z "$creds" && -f "$HOME/.claude/.credentials.json" ]]; then
        creds="$(<"$HOME/.claude/.credentials.json")"
    fi
    token="$(jq -r '.claudeAiOauth.accessToken // empty' <<<"$creds" 2>/dev/null || true)"
    if [[ -z "$token" ]]; then
        # The login keychain is locked in ssh sessions, so macOS over ssh
        # lands here even when signed in.
        echo "no readable Claude Code credentials (keychain or ~/.claude/.credentials.json)"
        return 1
    fi
    expires_ms="$(jq -r '.claudeAiOauth.expiresAt // 0 | floor' <<<"$creds")"
    if ((expires_ms > 0 && expires_ms / 1000 <= $(date +%s))); then
        echo "token expired; run claude once to refresh it"
        return 1
    fi

    # The endpoint only answers Claude Code's own user agent and beta header.
    data="$(
        get_json "$CLAUDE_USAGE_URL" <<EOF
header = "Authorization: Bearer $token"
header = "anthropic-beta: oauth-2025-04-20"
header = "User-Agent: claude-code/2.1.0"
EOF
    )" || {
        echo "$data"
        return 1
    }

    # `limits` is the current shape; five_hour/seven_day is the older one, kept
    # for accounts that still get only that. A plan without a 5-hour limit
    # simply has no session entry.
    jq -r '
        def row($label; $pct; $reset): [$label, ($pct | tostring), ($reset // "")] | @tsv;
        if (.limits // [] | length) > 0 then
            .limits[]
            | select(.percent != null)
            | if .kind == "session" then row("Current session"; .percent; .resets_at)
              elif .kind == "weekly_all" then row("Current week"; .percent; .resets_at)
              elif .kind == "weekly_scoped" then
                row("Current week (\(.scope.model.display_name // .scope.surface // "scoped"))"; .percent; .resets_at)
              else row(.kind; .percent; .resets_at) end
        else
            (.five_hour | select(.utilization != null) | row("Current session"; .utilization; .resets_at)),
            (.seven_day | select(.utilization != null) | row("Current week"; .utilization; .resets_at))
        end' <<<"$data"
}

codex_windows() {
    local auth="${CODEX_HOME:-$HOME/.codex}/auth.json" token account data
    if [[ ! -f "$auth" ]]; then
        echo "not signed in (no $auth)"
        return 1
    fi
    token="$(jq -r '.tokens.access_token // empty' "$auth")"
    account="$(jq -r '.tokens.account_id // empty' "$auth")"
    if [[ -z "$token" ]]; then
        echo "not signed in (no access token in $auth)"
        return 1
    fi

    data="$(
        get_json "$CODEX_USAGE_URL" <<EOF
header = "Authorization: Bearer $token"
header = "ChatGPT-Account-Id: $account"
header = "User-Agent: usage-script"
EOF
    )" || {
        [[ "$data" == token* ]] && data+="; run codex once to refresh it"
        echo "$data"
        return 1
    }

    jq -r '
        .rate_limit // {}
        | [.primary_window, .secondary_window][]
        | select(. != null and .used_percent != null)
        | [ (if .limit_window_seconds == 18000 then "Current session"
             elif .limit_window_seconds == 604800 then "Current week"
             else "\((.limit_window_seconds // 0) / 3600 | floor)-hour window" end),
            (.used_percent | tostring),
            (.reset_at // "" | tostring) ]
        | @tsv' <<<"$data" | sort
}

# "Nov 14, 6pm (PST)" in the local timezone, from epoch seconds or ISO 8601.
format_reset() {
    [[ -n "$1" ]] || {
        echo unknown
        return
    }
    jq -rn --arg t "$1" '
        (if ($t | test("^[0-9]+$")) then ($t | tonumber)
         else ($t | sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | fromdateiso8601) end)
        | strflocaltime("%b|%d|%I|%M|%p|%Z") | split("|")
        | "\(.[0]) \(.[1] | tonumber), \(.[2] | tonumber)"
          + (if .[3] == "00" then "" else ":\(.[3])" end)
          + "\(.[4] | ascii_downcase) (\(.[5]))"' 2>/dev/null || echo "$1"
}

# A bar of BAR_WIDTH cells with half-cell resolution.
bar() {
    local units cells i out=""
    units="$(jq -n --argjson p "$1" --argjson w "$BAR_WIDTH" \
        '[0, ([$p, 100] | min)] | max | . / 100 * $w * 2 | round')"
    cells=$((units / 2))
    for ((i = 0; i < cells; i++)); do out+="█"; done
    if ((units % 2)); then
        out+="▌"
        cells=$((cells + 1))
    fi
    # Padded by hand: printf's field width counts bytes, not characters.
    for ((i = cells; i < BAR_WIDTH; i++)); do out+=" "; done
    printf '%s' "$out"
}

render() {
    local name="$1" file="$2" ok="$3" label pct reset first=1
    echo "$name"
    if [[ "$ok" != 0 ]]; then
        echo "  unavailable: $(<"$file")"
        return
    fi
    if [[ ! -s "$file" ]]; then
        echo "  unavailable: the usage response had no windows this script recognises"
        return
    fi
    while IFS=$'\t' read -r label pct reset; do
        ((first)) || echo
        first=0
        echo "  $label"
        echo "  $(bar "$pct") $(jq -n --argjson p "$pct" '$p | round')% used"
        echo "  Resets $(format_reset "$reset")"
    done <"$file"
    if ! grep -q '^Current session' "$file"; then
        echo
        echo "  No 5-hour session limit is reported for this plan."
    fi
}

main() {
    case "${1:-}" in
        -h | --help | help)
            usage
            return 0
            ;;
    esac
    local tool
    for tool in curl jq; do
        command -v "$tool" >/dev/null || {
            echo "usg: $tool is required" >&2
            return 1
        }
    done

    local tmp claude_ok=0 codex_ok=0
    tmp="$(mktemp -d)"
    # Expanded now: tmp is local and out of scope when the trap fires.
    # shellcheck disable=SC2064
    trap "rm -rf '$tmp'" EXIT

    # Both requests run at once so the wait is the slower of the two.
    claude_windows >"$tmp/claude" &
    local claude_pid=$!
    codex_windows >"$tmp/codex" &
    local codex_pid=$!
    wait "$claude_pid" || claude_ok=1
    wait "$codex_pid" || codex_ok=1

    render Claude "$tmp/claude" "$claude_ok"
    echo
    render Codex "$tmp/codex" "$codex_ok"
}

main "$@"
