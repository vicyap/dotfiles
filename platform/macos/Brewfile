# Homebrew formulae for macOS. GUI casks are declared in nix/darwin/lima.nix,
# and the general CLI tool set, formatters, and linters in
# nix/home/features/packages.nix; AGENTS.md "Tool Management" has the policy.

# git, vim, and zsh are needed before home-manager has run (to clone this repo
# and as the login shell), so they are installed here as well.
brew "git"
brew "vim"
brew "curl"
brew "wget"
brew "watch"
brew "p7zip"
brew "qrencode"

brew "cmake"

# Development
brew "mise"
brew "cocoapods"
brew "watchman"
brew "imagemagick"
brew "aria2"
brew "rclone"
brew "redis"
brew "pandoc"
brew "exiftool"
brew "gifsicle"
brew "ocrmypdf"
brew "poppler"
brew "pdfly"
brew "signal-cli"

# Language tooling (typescript-language-server comes from mise's npm backend
# on both OSes — see packages/mise/.config/mise/config.toml)
brew "eslint"
brew "zig"

# Cloud / infra
brew "awscli"

# Shell
brew "zsh"
brew "zsh-completions"

# Taps
tap "turbot/tap"
brew "steampipe"
tap "namespacelabs/namespace"
brew "namespacelabs/namespace/nsc"
