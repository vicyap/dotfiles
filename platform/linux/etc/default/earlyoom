# earlyoom — kill the largest memory hog early instead of letting a swap-
# exhausted moment livelock the box. See the 2026-06-17 postmortem. rhinestone-only.
#
# systemd splits EARLYOOM_ARGS on whitespace and does NOT honor shell quotes,
# so the --avoid/--prefer regexes must contain no spaces.
#
#   -r 60     log a memory/swap report to the (persistent) journal every 60s
#   -m 10,5   act at <10% available RAM (SIGTERM), <5% (SIGKILL)
#   -s 5,2    act only when both available RAM and free swap are nearly
#             exhausted, retaining earlyoom as a last-resort circuit breaker.
#   --avoid   never target the SSH/tmux access path, shells, session
#             infrastructure, core systemd processes, Tailscale, or VMs
#             (qemu would be the largest process, but a SIGTERM is an unclean
#             poweroff; sacrifice dev processes instead), so the box stays
#             reachable through a kill
#   --prefer  select development runtimes first if the circuit breaker trips
EARLYOOM_ARGS="-r 60 -m 10,5 -s 5,2 --avoid ^(sshd|tailscaled|tmux.*|mosh.*|bash|zsh|fish|sh|dash|systemd.*|init|login|agetty|dbus-daemon|dbus-broker|qemu-system.*|libvirtd|virtqemud)$ --prefer ^(codex|claude|ripgrep|rg|node|bun|deno|python[0-9.]*|cc1.*|ld|java|go|rustc|cargo|beam.smp|chrome.*|chromium.*|headless_shel.*)$"
