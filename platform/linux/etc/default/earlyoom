# earlyoom — kill the largest memory hog early instead of letting a swap-
# exhausted moment livelock the box. See the 2026-06-17 postmortem. rhinestone-only.
#
# systemd splits EARLYOOM_ARGS on whitespace and does NOT honor shell quotes,
# so the --avoid/--prefer regexes must contain no spaces.
#
#   -r 60     log a memory/swap report to the (persistent) journal every 60s
#   -m 10,5   act at <10% available RAM (SIGTERM), <5% (SIGKILL)
#   -s 100,100  keep both the SIGTERM and SIGKILL paths memory-only. zram can
#             absorb cold pages before the memory threshold, but unused disk
#             swap must not defer earlyoom until the box is already thrashing.
#   --avoid   never target the SSH/tmux access path, core daemons, or VMs
#             (qemu would be the largest process, but a SIGTERM is an unclean
#             poweroff; sacrifice dev processes instead), so the box stays
#             reachable through a kill
#   --prefer  target the usual runaway dev processes first
EARLYOOM_ARGS="-r 60 -m 10,5 -s 100,100 --avoid ^(sshd|systemd.*|tmux.*|mosh.*|tailscaled|dockerd|containerd|init|login|qemu-system.*)$ --prefer ^(ripgrep|rg|node|python[0-9.]*|cc1.*|ld|java|chrome.*|chromium.*|headless_shel.*)$"
