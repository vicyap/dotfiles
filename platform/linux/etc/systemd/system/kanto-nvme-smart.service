[Unit]
Description=Record kanto NVMe SMART health for node_exporter
ConditionHost=kanto

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/kanto-nvme-smart
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/prometheus/node-exporter
ProtectControlGroups=yes
ProtectKernelTunables=yes
MemoryMax=64M
TasksMax=16
TimeoutStartSec=45s
